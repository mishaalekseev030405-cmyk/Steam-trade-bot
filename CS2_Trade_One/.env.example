# Copy to .env on the server and NEVER commit .env.
MARKET_CSGO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=0
DB_PATH=data/state.sqlite3

SCAN_SCOPE=watchlist
SCAN_EVERY_SECONDS=300
BATCH_SIZE=20
REQUEST_DELAY_SECONDS=0.5
BUDGET_RUB=3000
MIN_ITEM_RUB=50
MAX_ITEM_RUB=500
MIN_PROFIT_RUB=50
MIN_ROI_PERCENT=10
MIN_SALES_7D=20
SELL_FEE=0.10
MAX_POSITIONS=3

# Safe defaults: no live purchase endpoints are called.
DRY_RUN=true
LIVE_TRADING_ENABLED=false
AUTO_BUY_AFTER_FIRST=false
LIVE_TRADE_ACK=
