[Unit]
Description=CS2 Market read-only scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cs2bot
Group=cs2bot
WorkingDirectory=/opt/cs2-market-bot
EnvironmentFile=/etc/cs2-market-bot.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/cs2-market-bot/.venv/bin/python -m unittest discover -s tests -v
ExecStart=/opt/cs2-market-bot/.venv/bin/python /opt/cs2-market-bot/monitor.py
TimeoutStartSec=900
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cs2-market-bot
